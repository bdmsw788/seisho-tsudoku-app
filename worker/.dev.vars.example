# Cloudflare Workers ローカル開発用の環境変数テンプレート
# 実際の値は .dev.vars に設定し、本番では `wrangler secret put` で登録してください。
# npx @pushforge/builder vapid で生成した鍵を使用します。
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# クラウドバックアップ メール認証用（どちらか一方を設定）
# 方式1: Resend
RESEND_API_KEY=
MAIL_FROM=

# 方式2: Google Apps Script (GAS) Gmail中継
GAS_MAIL_WEBHOOK_URL=
GAS_MAIL_SECRET=
